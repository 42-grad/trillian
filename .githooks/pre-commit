#!/usr/bin/env bash
# Trillian pre-commit hook — runs the full CI pipeline locally before a commit,
# so anything that would fail in CI fails here first.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass in an emergency:  git commit --no-verify
set -euo pipefail

echo "[pre-commit] cargo fmt --check"
cargo fmt --check

echo "[pre-commit] cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "[pre-commit] cargo test"
cargo test --quiet

echo "[pre-commit] all checks passed"
