# Rust build output
/target

# Datasets & snapshots (large / reproducible) — but keep the example graph
*.nt
*.bin
!examples/graphrag/knowledge.nt

# Python / editor / OS junk
__pycache__/
*.pyc
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
.claude/

# Local scratch & profiling output
*.sparql
*.log
dhat-heap.json

# Local secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Generated WDBench working data (downloaded / built locally)
wdbench_data/
wdbench_qsrc/
wdbench_queries/
wdbench_queries_solo/
wdbench_queries_full/

# Secrets & local state — NEVER commit (Terraform state, SSH keypairs, inventory)
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/terraform.tfvars
infra/**/duel_key
infra/**/duel_key.pub
infra/**/inventory.ini
infra/aws/solo_csv/
