# Copy to a local shell environment before running graphrag.py:
#   export $(grep -v '^#' .env.example | xargs)   # or set these yourself

# Mistral AI API key — required only for the generation step.
# Without it, the example still runs and prints the retrieved subgraph.
MISTRAL_API_KEY=

# Mistral model used for the answer (optional).
MISTRAL_MODEL=mistral-small-latest

# Trillian SPARQL endpoint the example queries (optional).
TRILLIAN_SPARQL=http://localhost:9090/sparql
