---
const correctnessRows = [
  { cls: "Single BGP", compared: "267", matching: "267", deviation: "0", perfect: true },
  { cls: "Multiple BGP", compared: "661", matching: "661", deviation: "0", perfect: true },
  { cls: "Optional", compared: "315", matching: "239", deviation: "76" },
  { cls: "Property Paths", compared: "393", matching: "381", deviation: "12" },
  { cls: "C2RPQ", compared: "283", matching: "232", deviation: "51" },
];

const coverageRows = [
  { cls: "Single BGP", n: "280", trillian: "267", others: "280", capped: "13" },
  { cls: "Multiple BGP", n: "681", trillian: "665", others: "677", capped: "16" },
  { cls: "Optional", n: "498", trillian: "315", others: "498", capped: "183" },
  { cls: "Property Paths", n: "660", trillian: "397", others: "560", capped: "263" },
  { cls: "C2RPQ", n: "539", trillian: "308", others: "508", capped: "231" },
];

const latencyRows = [
  { cls: "Single BGP", trillian: "1", blazegraph: "69", jena: "279", virtuoso: "261", neo4j: "642" },
  { cls: "Multiple BGP", trillian: "131", blazegraph: "1,166", jena: "2,761", virtuoso: "8,436", neo4j: "—" },
  { cls: "Optional", trillian: "5,597", blazegraph: "1,892", jena: "3,368", virtuoso: "7,900", neo4j: "11,967" },
  { cls: "Property Paths", trillian: "4", blazegraph: "645", jena: "416", virtuoso: "738", neo4j: "4,612" },
  { cls: "C2RPQ", trillian: "187", blazegraph: "1,113", jena: "632", virtuoso: "2,755", neo4j: "—" },
];

const footprintRows = [
  { engine: "Trillian", size: "49 GB", bpt: "39", best: true },
  { engine: "Blazegraph", size: "70 GB", bpt: "56" },
  { engine: "Virtuoso", size: "70 GB", bpt: "56" },
  { engine: "Jena (TDB)", size: "110 GB", bpt: "87" },
  { engine: "Neo4j", size: "112 GB", bpt: "89" },
];
---

<section id="benchmarks">
  <div class="container">
    <span class="section-label">Performance</span>
    <h2>Benchmarked against<br /><span class="accent-gradient">the field</span></h2>
    <p class="section-sub">
      Measured on the full WDBench Wikidata graph — 1.26 billion triples — against published
      numbers for Blazegraph, Jena, Virtuoso, and Neo4j. Same query sets, 60 s timeout, 100k output cap.
    </p>

    <div class="method-card">
      <div class="method-head">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.5"/><path d="M9 5v5m0 2v.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <span>What is and isn't comparable</span>
      </div>
      <div class="method-grid">
        <div class="method-item">
          <span class="tag tag-ok">Directly comparable</span>
          <p><strong>Result correctness</strong> — per-query result counts against published numbers (below 100k must match exactly).</p>
        </div>
        <div class="method-item">
          <span class="tag tag-ok">Directly comparable</span>
          <p><strong>On-disk footprint</strong> — store size in bytes per triple, independent of hardware.</p>
        </div>
        <div class="method-item">
          <span class="tag tag-warn">Indicative only</span>
          <p><strong>Latency</strong> — different hardware (AWS r6i vs. the WDBench paper's Xeon Silver 4110). Treat absolute ms as a rough signal, not a controlled head-to-head.</p>
        </div>
        <div class="method-item">
          <span class="tag tag-warn">Indicative only</span>
          <p><strong>Architecture differs</strong> — Trillian is in-memory; the others are disk-backed with 64 GB RAM. Much of the latency gap is architectural.</p>
        </div>
      </div>
    </div>

    <div class="bench-grid">
      <div class="table-wrap">
        <div class="table-head">
          <h3>Result correctness <span class="unit">vs. published</span></h3>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Class</th>
                <th>Match</th>
                <th>Diff</th>
              </tr>
            </thead>
            <tbody>
              {correctnessRows.map((r) => (
                <tr class={r.perfect ? "perfect-row" : ""}>
                  <td class="cls">{r.cls}</td>
                  <td>{r.matching}<span class="muted">/{r.compared}</span></td>
                  <td class={r.perfect ? "ok-cell" : "warn-cell"}>{r.deviation}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="table-wrap">
        <div class="table-head">
          <h3>On-disk footprint <span class="unit">directly comparable</span></h3>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Engine</th>
                <th class="hl">Size</th>
                <th>B/triple</th>
              </tr>
            </thead>
            <tbody>
              {footprintRows.map((r) => (
                <tr class={r.best ? "best-row" : ""}>
                  <td class="cls">{r.engine}</td>
                  <td class="hl">{r.size}</td>
                  <td>{r.bpt}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="note-cards">
      <div class="note-card">
        <div class="note-head">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Correctness &amp; footprint</span>
        </div>
        <p>
          BGP is <strong>provably correct</strong> — 930 queries, zero deviations in result counts.
          Trillian's snapshot is the most compact store of the field at <strong>39 B/triple</strong>;
          in memory it holds the <strong>entire</strong> graph resident (~15 GB RSS post-load,
          growing toward 49 GB as the working set is touched).
        </p>
      </div>

      <div class="note-card note-card-warn">
        <div class="note-head">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="M8 5v3.5m0 2v.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span>Coverage &amp; latency caveats</span>
        </div>
        <p>
          <strong>"Capped"</strong> = Trillian's result-row cap fired on a degenerate query
          (a clean error, not a crash). <strong>Latency</strong> numbers are indicative:
          Trillian ran on AWS r6i; published numbers from the WDBench paper's Xeon Silver 4110,
          128 GB RAM. A fast median only covers completed queries — read it together with coverage.
        </p>
      </div>
    </div>

    <div class="bench-grid">
      <div class="table-wrap">
        <div class="table-head">
          <h3>Coverage <span class="unit">completed within 60 s</span></h3>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Class</th>
                <th class="hl">Trillian</th>
                <th>Others</th>
                <th>Capped</th>
              </tr>
            </thead>
            <tbody>
              {coverageRows.map((r) => (
                <tr>
                  <td class="cls">{r.cls}<span class="muted"> ({r.n})</span></td>
                  <td class="hl">{r.trillian}</td>
                  <td>{r.others}</td>
                  <td class="warn-cell">{r.capped}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="table-wrap latency-wrap">
        <div class="table-head latency-head">
          <h3>Median latency <span class="unit">ms, completed</span></h3>
          <span class="indicative-badge">Indicative</span>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Class</th>
                <th class="hl">Tril.</th>
                <th>Blaz.</th>
                <th>Jena</th>
                <th>Virt.</th>
                <th>Neo4j</th>
              </tr>
            </thead>
            <tbody>
              {latencyRows.map((r) => (
                <tr>
                  <td class="cls">{r.cls}</td>
                  <td class="hl">{r.trillian}</td>
                  <td>{r.blazegraph}</td>
                  <td>{r.jena}</td>
                  <td>{r.virtuoso}</td>
                  <td>{r.neo4j}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .method-card {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .method-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .method-head svg { color: var(--accent); }

  .method-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.75rem;
  }

  .method-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .method-item p {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .method-item strong { color: var(--text); font-weight: 600; }

  .tag {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.18rem 0.55rem;
    border-radius: 100px;
  }

  .tag-ok {
    background: rgba(0, 212, 176, 0.1);
    color: var(--accent);
    border: 1px solid rgba(0, 212, 176, 0.25);
  }

  .tag-warn {
    background: rgba(255, 180, 0, 0.08);
    color: #ffb400;
    border: 1px solid rgba(255, 180, 0, 0.2);
  }

  .bench-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .table-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .table-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .table-head h3 {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }

  .table-head .unit {
    color: var(--text-muted);
    font-weight: 400;
    font-size: 0.76rem;
  }

  .indicative-badge {
    font-size: 0.64rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 100px;
    background: rgba(255, 180, 0, 0.08);
    color: #ffb400;
    border: 1px solid rgba(255, 180, 0, 0.2);
    white-space: nowrap;
  }

  .table-scroll { overflow-x: auto; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  thead th {
    text-align: left;
    padding: 0.7rem 1.25rem;
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  thead th.hl { color: var(--accent); }

  tbody td {
    padding: 0.65rem 1.25rem;
    border-bottom: 1px solid rgba(28, 28, 56, 0.4);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  tbody tr:last-child td { border-bottom: none; }

  tbody td.cls {
    color: var(--text);
    font-weight: 500;
  }

  tbody td.hl {
    color: var(--accent);
    font-weight: 700;
  }

  .muted { color: var(--text-muted); font-size: 0.82em; }

  .ok-cell { color: var(--accent) !important; font-weight: 600; }
  .warn-cell { color: #ffb400 !important; }

  .perfect-row td,
  .best-row td {
    background: rgba(0, 212, 176, 0.04);
  }

  .note-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .note-card {
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .note-card.note-card-warn {
    border-color: rgba(255, 180, 0, 0.15);
  }

  .note-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.6rem;
    letter-spacing: 0.01em;
  }

  .note-card svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .note-card-warn svg {
    color: #ffb400;
  }

  .note-card p {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .note-card strong {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 820px) {
    .bench-grid { grid-template-columns: 1fr; }
    .method-grid { grid-template-columns: 1fr; gap: 1rem; }
    .note-cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    table { font-size: 0.78rem; }
    thead th, tbody td { padding: 0.55rem 0.75rem; }
    .indicative-badge { display: none; }
  }
</style>
