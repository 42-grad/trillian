---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const B = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${B}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description || "A lean, fast RDF triple store and SPARQL engine written in Rust. In-memory, cache-friendly indexes with worst-case-optimal joins."} />
    <meta name="theme-color" content="#06060c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Trillian" />
    <meta property="og:description" content="A lean, fast RDF triple store and SPARQL engine written in Rust." />
    <meta property="og:image" content={`${B}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="cosmos" aria-hidden="true">
      <div class="stars stars-far"></div>
      <div class="stars stars-mid"></div>
      <div class="stars stars-near"></div>
      <div class="nebula nebula-1"></div>
      <div class="nebula nebula-2"></div>
    </div>
    <slot />
  </body>
</html>

<style>
  .cosmos {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(ellipse 100% 60% at 50% -10%, rgba(0, 102, 255, 0.04), transparent),
      radial-gradient(ellipse 80% 50% at 50% 110%, rgba(0, 212, 176, 0.03), transparent),
      var(--bg);
  }

  .stars {
    position: absolute;
    inset: 0;
  }

  .stars-far {
    background-image:
      radial-gradient(1px 1px at 13% 11%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 27% 34%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 41% 67%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 55% 23%, rgba(255,255,255,0.35), transparent),
      radial-gradient(1px 1px at 69% 89%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 83% 45%, rgba(255,255,255,0.45), transparent),
      radial-gradient(1px 1px at 91% 12%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 7% 78%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 34% 92%, rgba(255,255,255,0.25), transparent),
      radial-gradient(1px 1px at 62% 56%, rgba(255,255,255,0.35), transparent),
      radial-gradient(1px 1px at 48% 8%, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 76% 71%, rgba(255,255,255,0.4), transparent);
    background-size: 100% 100%;
    opacity: 0.6;
  }

  .stars-mid {
    background-image:
      radial-gradient(1.5px 1.5px at 22% 19%, rgba(0,212,176,0.4), transparent),
      radial-gradient(1.5px 1.5px at 58% 41%, rgba(255,255,255,0.5), transparent),
      radial-gradient(1.5px 1.5px at 74% 77%, rgba(0,102,255,0.35), transparent),
      radial-gradient(1.5px 1.5px at 12% 63%, rgba(255,255,255,0.45), transparent),
      radial-gradient(1.5px 1.5px at 88% 28%, rgba(0,212,176,0.3), transparent),
      radial-gradient(1.5px 1.5px at 44% 85%, rgba(255,255,255,0.4), transparent),
      radial-gradient(1.5px 1.5px at 67% 14%, rgba(255,255,255,0.35), transparent);
    opacity: 0.5;
    animation: drift 120s linear infinite;
  }

  .stars-near {
    background-image:
      radial-gradient(2px 2px at 18% 42%, rgba(255,255,255,0.6), transparent),
      radial-gradient(2px 2px at 72% 33%, rgba(0,212,176,0.5), transparent),
      radial-gradient(2px 2px at 39% 71%, rgba(255,255,255,0.5), transparent),
      radial-gradient(2px 2px at 85% 86%, rgba(255,255,255,0.4), transparent);
    opacity: 0.7;
    animation: drift 200s linear infinite reverse;
  }

  @keyframes drift {
    from { transform: translateY(0); }
    to { transform: translateY(-100px); }
  }

  .nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .nebula-1 {
    top: 5%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 212, 176, 0.06), transparent 70%);
  }

  .nebula-2 {
    bottom: 10%;
    left: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 102, 255, 0.05), transparent 70%);
  }
</style>
